generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email           String          @unique
  passwordHash    String          @map("password_hash")
  role            String
  isActive        Boolean?        @default(true) @map("is_active")
  createdAt       DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?       @default(now()) @map("updated_at") @db.Timestamp(6)
  passwordChanged Boolean         @default(false) @map("password_changed")
  admin           Admin?
  announcements   Announcement[]
  communityPosts  CommunityPost[]
  fcmTokens       FcmToken[]
  notifications   Notification[]
  postComments    PostComment[]
  postLikes       PostLike[]
  student         Student?
  teacher         Teacher?

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Department {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(100)
  code           String          @unique @db.VarChar(10)
  description    String?
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?       @default(now()) @map("updated_at") @db.Timestamp(6)
  admins         Admin[]
  announcements  Announcement[]
  communityPosts CommunityPost[]
  courses        Course[]
  students       Student[]
  teachers       Teacher[]

  @@map("departments")
}

model Student {
  id             String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String              @unique @map("user_id") @db.Uuid
  rollNumber     String              @unique @map("roll_number")
  batch          Int
  createdAt      DateTime?           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamp(6)
  departmentId   Int?                @map("department_id")
  phone          String?
  address        String?
  fatherName     String?             @map("father_name")
  guardianPhone  String?             @map("guardian_phone")
  emergencyPhone String?             @map("emergency_phone")
  targetCgpa     Decimal?            @default(3.0) @map("target_cgpa") @db.Decimal
  studyIntensity String?             @default("balanced") @map("study_intensity")
  enrollments    Enrollment[]
  assignments    StudentAssignment[]
  department     Department?         @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_students_user_id")
  @@map("students")
}

model Teacher {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String           @unique @map("user_id") @db.Uuid
  employeeId   String           @unique @map("employee_id")
  createdAt    DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  departmentId Int?             @map("department_id")
  offerings    CourseOffering[]
  department   Department?      @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_teachers_user_id")
  @@map("teachers")
}

model Admin {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String      @unique @map("user_id") @db.Uuid
  adminId      String      @unique @map("admin_id")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admins")
}

model Course {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code         String           @unique
  title        String
  creditHours  Int              @map("credit_hours")
  createdAt    DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  hasPractical Boolean?         @default(false) @map("has_practical")
  updatedAt    DateTime?        @default(now()) @map("updated_at") @db.Timestamp(6)
  departmentId Int?             @map("department_id")
  offerings    CourseOffering[]
  department   Department?      @relation(fields: [departmentId], references: [id], onUpdate: NoAction)

  @@index([code], map: "idx_courses_code")
  @@map("courses")
}

model CourseOffering {
  id                  String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseId            String                 @map("course_id") @db.Uuid
  teacherId           String?                @map("teacher_id") @db.Uuid
  semester            String
  section             String
  capacity            Int
  createdAt           DateTime?              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamp(6)
  midWeight           Decimal                @default(30) @map("mid_weight") @db.Decimal
  sessionalWeight     Decimal                @default(20) @map("sessional_weight") @db.Decimal
  finalWeight         Decimal                @default(50) @map("final_weight") @db.Decimal
  practicalWeight     Decimal                @default(0) @map("practical_weight") @db.Decimal
  announcementTargets AnnouncementOffering[]
  announcementsLegacy Announcement[]         @relation("AnnouncementLegacyOffering")
  assignments         Assignment[]
  attendanceSessions  AttendanceSession[]
  course              Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher             Teacher?               @relation(fields: [teacherId], references: [id], onUpdate: NoAction)
  enrollments         Enrollment[]
  scheduleExceptions  ScheduleException[]
  schedules           Schedule[]

  @@unique([courseId, semester, section])
  @@index([courseId], map: "idx_offerings_course")
  @@index([teacherId], map: "idx_offerings_teacher")
  @@map("course_offerings")
}

model Enrollment {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId         String             @map("student_id") @db.Uuid
  offeringId        String             @map("offering_id") @db.Uuid
  status            String?            @default("enrolled")
  enrolledAt        DateTime?          @default(now()) @map("enrolled_at") @db.Timestamp(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamp(6)
  attendanceRecords AttendanceRecord[]
  offering          CourseOffering     @relation(fields: [offeringId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grades            Grade[]

  @@unique([studentId, offeringId])
  @@index([offeringId], map: "idx_enrollments_offering")
  @@index([offeringId, status], map: "idx_enrollments_offering_status")
  @@index([studentId], map: "idx_enrollments_student")
  @@map("enrollments")
}

model Schedule {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  offeringId         String              @map("offering_id") @db.Uuid
  dayOfWeek          String              @map("day_of_week")
  startTime          DateTime            @map("start_time") @db.Time(6)
  endTime            DateTime            @map("end_time") @db.Time(6)
  room               String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamp(6)
  attendanceSessions AttendanceSession[]
  exceptions         ScheduleException[]
  offering           CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([offeringId], map: "idx_schedules_offering_id")
  @@map("schedules")
}

model ScheduleException {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  offeringId         String              @map("offering_id") @db.Uuid
  scheduleId         String?             @map("schedule_id") @db.Uuid
  date               DateTime            @db.Date
  exceptionType      String              @map("exception_type")
  newStartTime       DateTime?           @map("new_start_time") @db.Time(6)
  newEndTime         DateTime?           @map("new_end_time") @db.Time(6)
  newRoom            String?             @map("new_room")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  attendanceSessions AttendanceSession[]
  offering           CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schedule           Schedule?           @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([offeringId], map: "idx_schedule_exceptions_offering_id")
  @@map("schedule_exceptions")
}

model AttendanceSession {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  offeringId  String             @map("offering_id") @db.Uuid
  date        DateTime           @db.Date
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  scheduleId  String?            @map("schedule_id") @db.Uuid
  exceptionId String?            @map("exception_id") @db.Uuid
  records     AttendanceRecord[]
  exception   ScheduleException? @relation(fields: [exceptionId], references: [id], onUpdate: NoAction)
  offering    CourseOffering     @relation(fields: [offeringId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schedule    Schedule?          @relation(fields: [scheduleId], references: [id], onUpdate: NoAction)

  @@unique([offeringId, date])
  @@index([date], map: "idx_attendance_sessions_date")
  @@index([exceptionId], map: "idx_attendance_sessions_exception")
  @@index([offeringId], map: "idx_attendance_sessions_offering_id")
  @@index([scheduleId], map: "idx_attendance_sessions_schedule")
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionId    String            @map("session_id") @db.Uuid
  status       String
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  enrollmentId String            @map("enrollment_id") @db.Uuid
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId], map: "idx_attendance_records_enrollment_id")
  @@map("attendance_records")
}

model Assignment {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  offeringId         String              @map("offering_id") @db.Uuid
  title              String
  description        String?
  dueDate            DateTime            @map("due_date") @db.Timestamp(6)
  totalPoints        Decimal             @map("total_points") @db.Decimal
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  isDone             Boolean             @default(false) @map("is_done")
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamp(6)
  assessmentType     String              @default("assignment") @map("assessment_type")
  difficulty         String?             @default("Medium")
  priority           String?             @default("Normal")
  offering           CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grades             Grade[]             @relation("GradeAssignment")
  studentAssignments StudentAssignment[]

  @@index([offeringId], map: "idx_assignments_offering_id")
  @@map("assignments")
}

model StudentAssignment {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId    String     @map("student_id") @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  progress     Int        @default(0)
  status       String     @default("pending")
  submittedAt  DateTime?  @map("submitted_at") @db.Timestamp(6)
  fileUrl      String?    @map("file_url")
  textContent  String?    @map("text_content")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamp(6)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([studentId, assignmentId])
  @@index([studentId, status], map: "idx_student_assignments_status")
  @@index([studentId], map: "idx_student_assignments_student")
  @@map("student_assignments")
}

model Grade {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assessmentType String      @map("assessment_type")
  referenceId    String?     @map("reference_id") @db.Uuid
  title          String
  score          Decimal     @db.Decimal
  maxScore       Decimal     @map("max_score") @db.Decimal
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  enrollmentId   String      @map("enrollment_id") @db.Uuid
  updatedAt      DateTime    @default(now()) @map("updated_at") @db.Timestamp(6)
  enrollment     Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignment     Assignment? @relation("GradeAssignment", fields: [referenceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([enrollmentId, assessmentType], map: "idx_grades_unique_assessment", where: raw("((reference_id IS NULL) AND (assessment_type <> 'assignment'::text))"))
  @@unique([enrollmentId, referenceId], map: "idx_grades_unique_assignment", where: raw("(reference_id IS NOT NULL)"))
  @@index([enrollmentId], map: "idx_grades_enrollment_id")
  @@map("grades")
}

model FcmToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_fcm_tokens_user_id")
  @@map("fcm_tokens")
}

model Announcement {
  id              String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authorId        String                 @map("author_id") @db.Uuid
  title           String
  content         String
  offeringId      String?                @map("offering_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  semester        String?
  departmentId    Int?                   @map("department_id")
  offeringTargets AnnouncementOffering[]
  author          User                   @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department      Department?            @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  legacyOffering  CourseOffering?        @relation("AnnouncementLegacyOffering", fields: [offeringId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([offeringId], map: "idx_announcements_offering")
  @@map("announcements")
}

model AnnouncementOffering {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  announcementId String         @map("announcement_id") @db.Uuid
  offeringId     String         @map("offering_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offering       CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([announcementId, offeringId])
  @@map("announcement_offerings")
}

model Notification {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String
  title       String
  message     String
  referenceId String?  @map("reference_id") @db.Uuid
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_unread_latest", where: raw("(is_read = false)"))
  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_id_created")
  @@index([userId], map: "idx_notifications_user_unread", where: raw("(is_read = false)"))
  @@map("notifications")
}

model CommunityPost {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authorId     String        @map("author_id") @db.Uuid
  title        String
  content      String
  status       String        @default("active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamp(6)
  departmentId Int?          @map("department_id")
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comments     PostComment[]
  likes        PostLike[]

  @@index([departmentId], map: "idx_community_posts_department_id")
  @@index([status], map: "idx_community_posts_status")
  @@map("community_posts")
}

model PostComment {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  content   String
  status    String        @default("active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime      @default(now()) @map("updated_at") @db.Timestamp(6)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([postId], map: "idx_post_comments_post_id")
  @@map("post_comments")
}

model PostLike {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, userId])
  @@index([userId], map: "idx_post_likes_user_id")
  @@map("post_likes")
}
