# ── UniMate Backend Environment Variables ──────────────────────────────────────
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# On Render, set these in the dashboard under Environment → Environment Variables.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (Supabase → Settings → Database → Connection string → URI)
# Use the "Transaction mode" pooler URL for best compatibility with Render.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Connection pool size (default 10; keep below Supabase plan limits)
# DB_POOL_MAX=10

# ── Authentication ─────────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-generate-a-secure-random-string

# Separate secret for refresh tokens. Generate with:  openssl rand -hex 32
# If not set, falls back to JWT_SECRET (not recommended for production).
JWT_REFRESH_SECRET=change-me-generate-a-different-secure-random-string

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://admin.unimate.app,https://student.unimate.app
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=https://admin.unimate.app,https://student.unimate.app

# ── Firebase (Push Notifications) ─────────────────────────────────────────────
# Option 1: Path to the service account JSON file (local development)
FIREBASE_CREDENTIALS_PATH=./src/config/firebaseServiceAccountKey.json

# Option 2: The entire service account JSON as a single-line string (Render)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# ── Google Gemini AI ───────────────────────────────────────────────────────────
# API key for AI features. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
